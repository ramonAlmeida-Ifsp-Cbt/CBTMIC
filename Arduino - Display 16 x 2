#include <LiquidCrystal.h>
LiquidCrystal lcd1(12, 11, 5, 4, 3, 2);

// Definição dos pinos do Arduino para cada segmento
const int pinagem[6] = {12, 11, 5, 4, 3, 2};

void setup()
{
  //Configura todos os pinos dos segmentos como SAÍDA
  for (int i = 0; i < 5; i++)
  {
    pinMode(pinagem[i], OUTPUT);
  }
  
  Serial.begin(115200);
  
  lcd1.begin(16, 2);
}

void loop()
{
  lcd1.clear();
  lcd1.setCursor(1,1);
  lcd1.print(analogRead(A0));
  delay(500);
}
